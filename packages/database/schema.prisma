generator client {
  provider = "prisma-client"
  output = "./generated"
}
datasource db {
  provider = "postgresql"
}
model User {
  id          String   @id @default(uuid()) @db.Uuid
  googleSub   String   @unique
  displayName String
  avatar      String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
