{
  "name": "resonance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @resonance/api\" \"npm run dev -w @resonance/web\"",
    "build": "npm run build -w @resonance/web && npm run typecheck",
    "typecheck": "tsc --noEmit && npm run typecheck -w @resonance/web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "format": "prettier --write apps/*/src packages/*/src tests docs README.md",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
