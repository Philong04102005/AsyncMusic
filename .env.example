NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://resonance:resonance@localhost:5432/resonance
REDIS_URL=redis://localhost:6379
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
DISCONNECT_GRACE_MS=15000
EMPTY_ROOM_GRACE_MS=15000
# Set only behind your trusted reverse proxy; never trust arbitrary forwarding headers.
TRUST_PROXY=false
